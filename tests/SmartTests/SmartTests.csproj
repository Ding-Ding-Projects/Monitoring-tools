<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the clipboard detectors, the tab defaults and the install note on any machine (dotnet run in this folder) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\MonitoringTools\Clip\Smart\*.cs" Link="Smart\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\MonitoringTools\Core\TabDefaults.cs;..\..\src\MonitoringTools\Core\InstallNote.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
