<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MonitoringTools</AssemblyName>
    <RootNamespace>MonitoringTools</RootNamespace>
    <StartupObject>MonitoringTools.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Monitoring Tools</Product>
    <Company>Ding-Ding-Projects</Company>
    <Description>Clipboard toasts, internet watch and quick media conversion for Windows.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Bundled dependencies fetched by download-dependencies (pinned and digest-verified).
       They are embedded so the single exe works offline; BundledTools extracts them on first use. -->
  <PropertyGroup>
    <DepsDir>$(MSBuildThisFileDirectory)..\..\.deps\</DepsDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(DepsDir)ffmpeg\*.exe;$(DepsDir)ffmpeg\*.dll" LogicalName="bundled/ffmpeg/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(DepsDir)cache\MinGit-*-64-bit.zip" LogicalName="bundled/mingit.zip" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\deps\manifest.json" LogicalName="bundled/manifest.json" />
  </ItemGroup>

  <!-- Stamps the build time into the app so the front screen can show when this exact build was made. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
  </ItemGroup>
</Project>
