<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>MonitoringTools</AssemblyName>
    <RootNamespace>MonitoringTools</RootNamespace>
    <StartupObject>MonitoringTools.Program</StartupObject>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Monitoring Tools</Product>
    <Company>Ding-Ding-Projects</Company>
    <Description>Clipboard toasts, internet watch and quick media conversion for Windows.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416;WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- Bundled dependencies fetched by download-dependencies (pinned and digest-verified).
       They are embedded so the single exe works offline; BundledTools extracts them on first use. -->
  <PropertyGroup>
    <DepsDir>$(MSBuildThisFileDirectory)..\..\.deps\</DepsDir>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(DepsDir)ffmpeg\*.exe;$(DepsDir)ffmpeg\*.dll" LogicalName="bundled/ffmpeg/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(DepsDir)cache\MinGit-*-64-bit.zip" LogicalName="bundled/mingit.zip" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\deps\manifest.json" LogicalName="bundled/manifest.json" />
    <Resource Include="$(DepsDir)roboto\Roboto-Light.ttf;$(DepsDir)roboto\Roboto-Regular.ttf;$(DepsDir)roboto\Roboto-Medium.ttf;$(DepsDir)roboto\Roboto-Bold.ttf" Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The offline documentation shown on the Help and docs page: every feature article, the README and
       the screenshots those articles reference. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\features\**\*.md" LogicalName="docs/features/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\README.md" LogicalName="docs/README.md" />
    <EmbeddedResource Include="..\..\docs\screenshots\toast-link.png;..\..\docs\screenshots\toast-compose.png;..\..\docs\screenshots\control-history.png;..\..\docs\screenshots\control-conversion.png;..\..\docs\screenshots\commit-template.png;..\..\docs\screenshots\control-shortcuts.png;..\..\docs\screenshots\offline-dialog.png;..\..\docs\screenshots\control-network.png;..\..\docs\screenshots\control-game.png;..\..\docs\screenshots\filetools-move.png;..\..\docs\screenshots\filetools-base64.png;..\..\docs\screenshots\filetools-encrypt.png;..\..\docs\screenshots\control-minecraft.png;..\..\docs\screenshots\control-service.png;..\..\docs\screenshots\tray-menu.png;..\..\docs\screenshots\command-palette.png" LogicalName="docs/screenshots/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Stamps the build time into the app so the front screen can show when this exact build was made. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTimeUtc" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>
</Project>
