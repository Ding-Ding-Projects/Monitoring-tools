<Window x:Class="MonitoringTools.UI.OfflineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="524" UseLayoutRounding="True" Title="Internet connection lost">
    <Grid x:Name="Root" Margin="20,14,20,24">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift"/>
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="{DynamicResource B.Raised}" BorderThickness="1" Effect="{DynamicResource Fx.Shadow}">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="EdgeBrush" Color="{DynamicResource C.Line}"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <!-- header -->
                    <Grid Margin="22,22,22,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Top">
                            <Ellipse x:Name="Ring1" RenderTransformOrigin="0.5,0.5" StrokeThickness="2">
                                <Ellipse.Stroke><SolidColorBrush x:Name="Ring1Brush" Color="{DynamicResource C.Amber}"/></Ellipse.Stroke>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring1Scale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="Ring2" RenderTransformOrigin="0.5,0.5" StrokeThickness="2">
                                <Ellipse.Stroke><SolidColorBrush x:Name="Ring2Brush" Color="{DynamicResource C.Amber}"/></Ellipse.Stroke>
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Ring2Scale"/></Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse>
                                <Ellipse.Fill><SolidColorBrush x:Name="BadgeBrush" Color="{DynamicResource C.AmberWash}"/></Ellipse.Fill>
                            </Ellipse>
                            <ContentControl x:Name="BadgeIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="Headline" Style="{StaticResource T.Title}" FontSize="22" Text="Internet connection lost"/>
                            <TextBlock x:Name="Explain" Style="{StaticResource T.Body}" FontSize="14" Margin="0,4,0,0" LineHeight="20"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" VerticalAlignment="Top" Margin="12,0,0,0"
                                Click="OnDismiss" ToolTip="Dismiss until the connection changes" AutomationProperties.Name="Dismiss">
                            <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="Body">
                        <!-- probe ladder -->
                        <TextBlock Text="PROBE LADDER" Style="{StaticResource T.Eyebrow}" Margin="22,0,22,8"/>
                        <UniformGrid x:Name="Ladder" Rows="1" Columns="4" Margin="18,0,18,16"/>

                        <!-- details -->
                        <Border Margin="22,0,22,0" Padding="14,12" CornerRadius="20" Background="{DynamicResource B.Sunken}"
                                BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
                            <UniformGrid x:Name="DetailsGrid" Columns="2"/>
                        </Border>

                        <!-- actions -->
                        <WrapPanel x:Name="Actions" Margin="22,16,22,0"/>
                        <Grid Margin="22,4,22,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SWITCH DNS" Style="{StaticResource T.Eyebrow}" VerticalAlignment="Top" Margin="0,10,10,8"/>
                            <WrapPanel x:Name="DnsChips" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="22,6,22,18">
                            <TextBlock x:Name="Status" Style="{StaticResource T.Body}" FontSize="12" Foreground="{DynamicResource B.TextMute}"/>
                            <TextBlock x:Name="Countdown" Style="{StaticResource T.Mono}" Foreground="{DynamicResource B.TextMute}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Height="3" CornerRadius="0,0,28,28" Background="{DynamicResource B.Sunken}" ClipToBounds="True">
                    <Rectangle x:Name="Bar" RenderTransformOrigin="0,0.5">
                        <Rectangle.Fill><SolidColorBrush x:Name="BarBrush" Color="{DynamicResource C.Amber}"/></Rectangle.Fill>
                        <Rectangle.RenderTransform><ScaleTransform x:Name="BarScale" ScaleX="0.3"/></Rectangle.RenderTransform>
                    </Rectangle>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
