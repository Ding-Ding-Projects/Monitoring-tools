<Window x:Class="MonitoringTools.UI.ControlCentreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring Tools" Width="1100" Height="740" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource B.Window}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar -->
        <Border Background="{DynamicResource B.Window}">
            <Grid Margin="14,14,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,4,0,22">
                    <Path x:Name="Logo" Data="M3 12h4l3-7 4 14 3-7h4" Stroke="{DynamicResource B.Mint}" StrokeThickness="2.2" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AppName" Text="Monitoring Tools" Style="{StaticResource T.Title}" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Border x:Name="NavIndicator" Height="40" VerticalAlignment="Top" CornerRadius="20" Background="{DynamicResource B.SecondaryContainer}">
                            <Border.RenderTransform><TranslateTransform x:Name="NavShift"/></Border.RenderTransform>
                        </Border>
                        <StackPanel x:Name="Nav"/>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="8,0,0,0">
                    <TextBlock x:Name="FooterState" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.TextMute}" FontSize="11"/>
                    <TextBlock x:Name="FooterVersion" Style="{StaticResource T.Mono}" Foreground="{DynamicResource B.TextMute}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Style="{StaticResource Btn.Row}" Width="46" Height="44" Click="OnMin" AutomationProperties.Name="Minimize">
                    <Path Data="M5 12h14" Stroke="{StaticResource B.TextSoft}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="MaxBtn" Style="{StaticResource Btn.Row}" Width="46" Height="44" Click="OnMax" AutomationProperties.Name="Maximize">
                    <Path Data="M5 5h14v14H5z" Stroke="{StaticResource B.TextSoft}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                </Button>
                <Button x:Name="CloseBtn" Style="{StaticResource Btn.Row}" Width="46" Height="44" Click="OnClose" AutomationProperties.Name="Close">
                    <Path Data="M6 6l12 12M18 6L6 18" Stroke="{StaticResource B.TextSoft}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,32">
                <ContentControl x:Name="Page"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
