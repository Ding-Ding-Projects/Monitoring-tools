<Window x:Class="MonitoringTools.UI.ControlCentreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring Tools" Width="1100" Height="740" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource B.Window}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- tab strip: docked left by default, moved to another edge from code (see UI/Tabs/TabStrip.cs) -->
        <Border x:Name="TabHost" Grid.Row="1" Grid.Column="0" Width="264" Background="{DynamicResource B.Window}">
            <Grid x:Name="StripGrid" Margin="14,14,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="BrandPanel" Grid.Row="0" Orientation="Horizontal" Margin="8,4,0,16">
                    <Path x:Name="Logo" Data="M3 12h4l3-7 4 14 3-7h4" Stroke="{DynamicResource B.Mint}" StrokeThickness="2.2" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AppName" Text="Monitoring Tools" Style="{StaticResource T.Title}" FontSize="22" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer x:Name="TabScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12"/>
                <StackPanel x:Name="ActionBar" Grid.Row="2"/>
                <StackPanel x:Name="FooterPanel" Grid.Row="3" Margin="8,8,0,0">
                    <TextBlock x:Name="FooterState" Style="{StaticResource T.Mono}" Foreground="{DynamicResource B.TextMute}" FontSize="11"/>
                    <TextBlock x:Name="FooterVersion" Style="{StaticResource T.Mono}" Foreground="{DynamicResource B.TextMute}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- content -->
        <Grid x:Name="ContentHost" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentCaptionRow" Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,0,32,32">
                <ContentControl x:Name="Page"/>
            </ScrollViewer>
        </Grid>

        <!-- window buttons stay top right whichever edge the tab strip is docked to -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="44"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinBtn" Style="{StaticResource Btn.Row}" Width="46" Height="44" Click="OnMin" AutomationProperties.Name="Minimize">
                <Path Data="M5 12h14" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="MaxBtn" Style="{StaticResource Btn.Row}" Width="46" Height="44" Click="OnMax" AutomationProperties.Name="Maximize">
                <Path Data="M5 5h14v14H5z" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
            </Button>
            <Button x:Name="CloseBtn" Style="{StaticResource Btn.Row}" Width="46" Height="44" Click="OnClose" AutomationProperties.Name="Close">
                <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
