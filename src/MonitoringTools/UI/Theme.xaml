<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Material 3 colour roles, seed Mint, dark scheme. Appearance.Apply replaces these at run time
         (every template below reads them through DynamicResource, so a theme change repaints live).
         Key names are kept from the first design so existing code keeps working:
         Ground = lowest container, Window = surface, Surface = surface container, Raised = container high,
         Sunken = container highest, Line = outline variant, LineStrong = outline, Text = on surface,
         TextSoft = on surface variant, TextMute = outline, Mint = primary, MintInk = on primary,
         MintWash = primary container. -->
    <Color x:Key="C.Ground">#FF0A0F0D</Color>
    <Color x:Key="C.Window">#FF0F1512</Color>
    <Color x:Key="C.Surface">#FF1B211E</Color>
    <Color x:Key="C.Raised">#FF262B28</Color>
    <Color x:Key="C.Sunken">#FF303633</Color>
    <Color x:Key="C.Line">#FF404943</Color>
    <Color x:Key="C.LineStrong">#FF89938C</Color>
    <Color x:Key="C.Text">#FFDEE4DF</Color>
    <Color x:Key="C.TextSoft">#FFBFC9C2</Color>
    <Color x:Key="C.TextMute">#FF89938C</Color>
    <Color x:Key="C.Mint">#FF6FDBB4</Color>
    <Color x:Key="C.MintInk">#FF003827</Color>
    <Color x:Key="C.MintWash">#FF00513A</Color>
    <Color x:Key="C.OnPrimaryContainer">#FF8CF8CF</Color>
    <Color x:Key="C.SecondaryContainer">#FF354B41</Color>
    <Color x:Key="C.OnSecondaryContainer">#FFCFE9DB</Color>
    <Color x:Key="C.TertiaryContainer">#FF244C5D</Color>
    <Color x:Key="C.OnTertiaryContainer">#FFC2E8FD</Color>
    <Color x:Key="C.Amber">#FFFFB95F</Color>
    <Color x:Key="C.AmberInk">#FF462A00</Color>
    <Color x:Key="C.AmberWash">#FF3B2A12</Color>
    <Color x:Key="C.Violet">#FFCFBCFF</Color>
    <Color x:Key="C.VioletWash">#FF2B2640</Color>
    <Color x:Key="C.Danger">#FFFFB4AB</Color>
    <Color x:Key="C.DangerWash">#FF93000A</Color>

    <SolidColorBrush x:Key="B.Ground" Color="{StaticResource C.Ground}"/>
    <SolidColorBrush x:Key="B.Window" Color="{StaticResource C.Window}"/>
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.Raised}"/>
    <SolidColorBrush x:Key="B.Sunken" Color="{StaticResource C.Sunken}"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="B.LineStrong" Color="{StaticResource C.LineStrong}"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextSoft" Color="{StaticResource C.TextSoft}"/>
    <SolidColorBrush x:Key="B.TextMute" Color="{StaticResource C.TextMute}"/>
    <SolidColorBrush x:Key="B.Mint" Color="{StaticResource C.Mint}"/>
    <SolidColorBrush x:Key="B.MintInk" Color="{StaticResource C.MintInk}"/>
    <SolidColorBrush x:Key="B.MintWash" Color="{StaticResource C.MintWash}"/>
    <SolidColorBrush x:Key="B.OnPrimaryContainer" Color="{StaticResource C.OnPrimaryContainer}"/>
    <SolidColorBrush x:Key="B.SecondaryContainer" Color="{StaticResource C.SecondaryContainer}"/>
    <SolidColorBrush x:Key="B.OnSecondaryContainer" Color="{StaticResource C.OnSecondaryContainer}"/>
    <SolidColorBrush x:Key="B.TertiaryContainer" Color="{StaticResource C.TertiaryContainer}"/>
    <SolidColorBrush x:Key="B.OnTertiaryContainer" Color="{StaticResource C.OnTertiaryContainer}"/>
    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}"/>
    <SolidColorBrush x:Key="B.AmberInk" Color="{StaticResource C.AmberInk}"/>
    <SolidColorBrush x:Key="B.AmberWash" Color="{StaticResource C.AmberWash}"/>
    <SolidColorBrush x:Key="B.Violet" Color="{StaticResource C.Violet}"/>
    <SolidColorBrush x:Key="B.VioletWash" Color="{StaticResource C.VioletWash}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.DangerWash" Color="{StaticResource C.DangerWash}"/>

    <!-- Roboto is vendored by download-dependencies (deps/manifest.json) and embedded under /Fonts. -->
    <FontFamily x:Key="F.Display">/MonitoringTools;component/Fonts/#Roboto, Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Body">/MonitoringTools;component/Fonts/#Roboto, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>

    <!-- Motion: emphasized decelerate for arrivals, a gentle overshoot for shape and selection. -->
    <CubicEase x:Key="E.Out" EasingMode="EaseOut"/>
    <BackEase x:Key="E.Spring" EasingMode="EaseOut" Amplitude="0.35"/>
    <DropShadowEffect x:Key="Fx.Shadow" BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.42" Color="Black"/>

    <!-- Tonal button: pill, secondary container, state layer on hover, squash on press. -->
    <Style x:Key="Btn.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.OnSecondaryContainer}"/>
        <Setter Property="Background" Value="{DynamicResource B.SecondaryContainer}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="20" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="State" CornerRadius="20" Background="{TemplateBinding Foreground}" Opacity="0"/>
                        <Border x:Name="Focus" CornerRadius="22" BorderBrush="{DynamicResource B.Mint}" BorderThickness="2" Margin="-3" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="State" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="State" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.12"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.95" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.95" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource E.Spring}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource E.Spring}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Filled button: the one primary action. -->
    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{DynamicResource B.Mint}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.MintInk}"/>
        <Setter Property="Padding" Value="24,0"/>
    </Style>
    <Style x:Key="Btn.Alert" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{DynamicResource B.Amber}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.AmberInk}"/>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{DynamicResource B.DangerWash}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Danger}"/>
    </Style>
    <!-- Chip: 32 high, 8 corner, outlined until selected. Code paints the selected state. -->
    <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
                        <Border x:Name="State" CornerRadius="8" Background="{TemplateBinding Foreground}" Opacity="0"/>
                        <Border x:Name="Focus" CornerRadius="10" BorderBrush="{DynamicResource B.Mint}" BorderThickness="2" Margin="-3" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Standard icon button: 40 circle with a state layer. -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextSoft}"/>
    </Style>
    <!-- Navigation and menu row: full pill, state layer on hover. -->
    <Style x:Key="Btn.Row" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="20" Background="{TemplateBinding Background}"/>
                        <Border x:Name="Hi" CornerRadius="20" Background="{DynamicResource B.Text}" Opacity="0"/>
                        <Border x:Name="Focus" CornerRadius="20" BorderBrush="{DynamicResource B.Mint}" BorderThickness="2" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0.08" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hi" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Material 3 switch: 52 x 32 track, the thumb grows from 16 to 24 and springs across. -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Tag" Value="{DynamicResource B.Mint}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Grid Grid.Column="1" Width="52" Height="32" VerticalAlignment="Center">
                            <Border x:Name="Focus" CornerRadius="20" BorderBrush="{DynamicResource B.Mint}" BorderThickness="2" Margin="-3" Opacity="0"/>
                            <Border x:Name="Track" CornerRadius="16" Background="{DynamicResource B.Sunken}" BorderBrush="{DynamicResource B.LineStrong}" BorderThickness="2"/>
                            <!-- the state layer: a 40 circle behind the thumb, 8 percent on hover and 12 percent pressed -->
                            <Border x:Name="Halo" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-4,0,0,0"
                                    Background="{DynamicResource B.LineStrong}" Opacity="0" IsHitTestVisible="False"/>
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Margin="8,0,0,0" Background="{DynamicResource B.LineStrong}">
                                <Border.RenderTransform><TranslateTransform x:Name="ThumbX"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Halo" Property="Margin" Value="16,0,0,0"/>
                            <Setter TargetName="Halo" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Track" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource B.MintInk}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.35" EasingFunction="{StaticResource E.Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" To="24" Duration="0:0:0.35" EasingFunction="{StaticResource E.Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height" To="24" Duration="0:0:0.35" EasingFunction="{StaticResource E.Spring}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource E.Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Width" To="16" Duration="0:0:0.3" EasingFunction="{StaticResource E.Spring}"/>
                                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height" To="16" Duration="0:0:0.3" EasingFunction="{StaticResource E.Spring}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Text field: container highest, 12 corner, primary outline and caret when focused. -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Mint}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Mint}"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource B.Sunken}"
                            BorderBrush="Transparent" BorderThickness="2" Padding="12,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Mint}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Raised}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Multi-line text field for the text toast: same look as Input, grows with its text, vertical padding, primary ring when focused. -->
    <Style x:Key="Input.Multi" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Mint}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Mint}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="12" Background="{DynamicResource B.Sunken}"
                            BorderBrush="Transparent" BorderThickness="2" Padding="10,8">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.Mint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Slim overlay scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="{DynamicResource B.Line}"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Type scale: label small eyebrow, title, body, mono. -->
    <Style x:Key="T.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextSoft}"/>
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Display}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.TextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
</ResourceDictionary>
