<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Graphite Signal palette -->
    <Color x:Key="C.Ground">#FF08090C</Color>
    <Color x:Key="C.Window">#FF0D0F13</Color>
    <Color x:Key="C.Surface">#FF14161B</Color>
    <Color x:Key="C.Raised">#FF1A1D23</Color>
    <Color x:Key="C.Sunken">#FF0F1115</Color>
    <Color x:Key="C.Line">#FF262A33</Color>
    <Color x:Key="C.LineStrong">#FF2E333D</Color>
    <Color x:Key="C.Text">#FFE8EAED</Color>
    <Color x:Key="C.TextSoft">#FFC9CDD4</Color>
    <Color x:Key="C.TextMute">#FF9AA1AD</Color>
    <Color x:Key="C.Mint">#FF7CF2C2</Color>
    <Color x:Key="C.MintInk">#FF062018</Color>
    <Color x:Key="C.MintWash">#FF1D2A26</Color>
    <Color x:Key="C.Amber">#FFFFB547</Color>
    <Color x:Key="C.AmberInk">#FF241703</Color>
    <Color x:Key="C.AmberWash">#FF2A2116</Color>
    <Color x:Key="C.Violet">#FFB9A2FF</Color>
    <Color x:Key="C.VioletWash">#FF1E1A2C</Color>
    <Color x:Key="C.Danger">#FFFF8A7A</Color>
    <Color x:Key="C.DangerWash">#FF2A1717</Color>

    <SolidColorBrush x:Key="B.Ground" Color="{StaticResource C.Ground}"/>
    <SolidColorBrush x:Key="B.Window" Color="{StaticResource C.Window}"/>
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="B.Raised" Color="{StaticResource C.Raised}"/>
    <SolidColorBrush x:Key="B.Sunken" Color="{StaticResource C.Sunken}"/>
    <SolidColorBrush x:Key="B.Line" Color="{StaticResource C.Line}"/>
    <SolidColorBrush x:Key="B.LineStrong" Color="{StaticResource C.LineStrong}"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextSoft" Color="{StaticResource C.TextSoft}"/>
    <SolidColorBrush x:Key="B.TextMute" Color="{StaticResource C.TextMute}"/>
    <SolidColorBrush x:Key="B.Mint" Color="{StaticResource C.Mint}"/>
    <SolidColorBrush x:Key="B.MintInk" Color="{StaticResource C.MintInk}"/>
    <SolidColorBrush x:Key="B.MintWash" Color="{StaticResource C.MintWash}"/>
    <SolidColorBrush x:Key="B.Amber" Color="{StaticResource C.Amber}"/>
    <SolidColorBrush x:Key="B.AmberInk" Color="{StaticResource C.AmberInk}"/>
    <SolidColorBrush x:Key="B.AmberWash" Color="{StaticResource C.AmberWash}"/>
    <SolidColorBrush x:Key="B.Violet" Color="{StaticResource C.Violet}"/>
    <SolidColorBrush x:Key="B.VioletWash" Color="{StaticResource C.VioletWash}"/>
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="B.DangerWash" Color="{StaticResource C.DangerWash}"/>

    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Body">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Mono">Cascadia Mono, Cascadia Code, Consolas</FontFamily>

    <CubicEase x:Key="E.Out" EasingMode="EaseOut"/>
    <BackEase x:Key="E.Spring" EasingMode="EaseOut" Amplitude="0.35"/>

    <DropShadowEffect x:Key="Fx.Shadow" BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.55" Color="Black"/>

    <!-- Ghost button: raised slate, hover lift, press squash -->
    <Style x:Key="Btn.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Raised}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.LineStrong}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="9" Background="#14FFFFFF" Opacity="0" Margin="-14,0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.96" Duration="0:0:0.08"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.96" Duration="0:0:0.08"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource E.Spring}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.25" EasingFunction="{StaticResource E.Spring}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{StaticResource B.Mint}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Mint}"/>
        <Setter Property="Foreground" Value="{StaticResource B.MintInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Btn.Alert" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{StaticResource B.Amber}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Amber}"/>
        <Setter Property="Foreground" Value="{StaticResource B.AmberInk}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{StaticResource B.DangerWash}"/>
        <Setter Property="BorderBrush" Value="#FF4A2525"/>
        <Setter Property="Foreground" Value="{StaticResource B.Danger}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Command chip: monospace ":mp4" pills -->
    <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="{StaticResource B.MintWash}"/>
        <Setter Property="BorderBrush" Value="#FF2B4A3F"/>
        <Setter Property="Foreground" Value="{StaticResource B.Mint}"/>
    </Style>

    <!-- Icon-only square button -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Menu row button for the tray menu and nav -->
    <Style x:Key="Btn.Row" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                        <Grid>
                            <Border x:Name="Hi" CornerRadius="10" Background="{StaticResource B.Raised}" Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Hi" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch with a sliding, springy thumb -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Tag" Value="{StaticResource B.Mint}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Border x:Name="Track" Grid.Column="1" Width="40" Height="24" CornerRadius="12"
                                Background="{StaticResource B.Raised}" BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1">
                            <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Left"
                                    Margin="3,0,0,0" Background="{StaticResource B.TextMute}">
                                <Border.RenderTransform><TranslateTransform x:Name="ThumbX"/></Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Thumb" Property="Background" Value="{StaticResource B.MintInk}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.28" EasingFunction="{StaticResource E.Spring}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="ThumbX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.28" EasingFunction="{StaticResource E.Spring}"/>
                                </Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Mint}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Mint}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource B.Sunken}"
                            BorderBrush="{StaticResource B.LineStrong}" BorderThickness="1" Padding="10,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Mint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim overlay scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#33FFFFFF"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="T.Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextMute}"/>
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

</ResourceDictionary>
