<Window x:Class="MonitoringTools.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="436" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root" Margin="18,12,18,22" RenderTransformOrigin="1,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="Card" CornerRadius="28" Background="{DynamicResource B.Raised}" BorderThickness="1"
                Effect="{StaticResource Fx.Shadow}">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="CardBorder" Color="{DynamicResource C.Line}"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- glow ring that appears on hover -->
                <Border x:Name="Halo" Grid.RowSpan="2" CornerRadius="28" Margin="-5" BorderThickness="4" Opacity="0" IsHitTestVisible="False">
                    <Border.BorderBrush>
                        <SolidColorBrush x:Name="HaloBrush" Color="{DynamicResource C.Mint}"/>
                    </Border.BorderBrush>
                </Border>

                <StackPanel Margin="20,18,20,16">
                    <Grid x:Name="Header">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="IconHost" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText" Grid.Column="1" Style="{StaticResource T.Title}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MetaText" Grid.Column="2" Style="{StaticResource T.Mono}" Foreground="{DynamicResource B.TextMute}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <StackPanel x:Name="Held" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0">
                            <Path Data="M9 5v14M15 5v14" Stroke="{DynamicResource B.Mint}" StrokeThickness="2.5" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0"/>
                            <TextBlock Text="held" FontSize="12" Foreground="{DynamicResource B.Mint}" FontFamily="{StaticResource F.Body}"/>
                        </StackPanel>
                        <TextBlock x:Name="WhenText" Grid.Column="3" Text="now" FontSize="12" Foreground="{DynamicResource B.TextMute}"
                                   FontFamily="{StaticResource F.Body}" VerticalAlignment="Center"/>
                        <Button x:Name="CloseBtn" Grid.Column="4" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Margin="8,0,0,0"
                                Opacity="0" ToolTip="Dismiss" Click="OnCloseClick" AutomationProperties.Name="Dismiss">
                            <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <ContentControl x:Name="BodyHost" Margin="0,10,0,0"/>
                    <TextBlock x:Name="HintText" Style="{StaticResource T.Body}" FontSize="12" Foreground="{DynamicResource B.TextMute}"
                               Margin="0,8,0,0" Visibility="Collapsed"/>

                    <Border x:Name="ActionsHost" MaxHeight="0" Opacity="0" ClipToBounds="True">
                        <StackPanel>
                            <WrapPanel x:Name="ActionsPanel" Margin="0,12,0,0"/>
                            <WrapPanel x:Name="ChipsPanel" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TipText" Style="{StaticResource T.Body}" FontSize="12" Foreground="{DynamicResource B.TextMute}"
                                       Margin="0,2,0,0" MinHeight="16"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Height="3" CornerRadius="0,0,24,24" Background="{DynamicResource B.Sunken}" ClipToBounds="True">
                    <Rectangle x:Name="TimerFill" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="TimerBrush" Color="{DynamicResource C.Mint}"/>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="TimerScale" ScaleX="1"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
