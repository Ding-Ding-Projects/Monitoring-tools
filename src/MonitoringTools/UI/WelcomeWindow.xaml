<Window x:Class="MonitoringTools.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="Height" Width="1040"
        WindowStartupLocation="CenterScreen" Title="Welcome to Monitoring Tools" UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="24" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="{DynamicResource B.Window}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                Effect="{DynamicResource Fx.Shadow}" Padding="33,36,33,32" MouseLeftButtonDown="OnDrag">
            <!-- Three rows: the welcome, the cards (they scroll when the screen is short) and the footer, which always shows. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="Hero" Margin="0,0,16,0">
                        <TextBlock Text="Welcome" Style="{StaticResource T.Eyebrow}" FontSize="12" Foreground="{DynamicResource B.Mint}"/>
                        <TextBlock Text="It lives in your tray now." Style="{StaticResource T.Title}" FontSize="36" Margin="0,8,0,8" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource T.Body}" FontSize="14" Foreground="{DynamicResource B.TextMute}" MaxWidth="540" HorizontalAlignment="Left"
                                   TextWrapping="Wrap" Text="Everything below works on its own. Press Try it to see each one right now instead of waiting for it to happen."/>
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Top" Background="{DynamicResource B.SecondaryContainer}" BorderBrush="{x:Null}"
                            BorderThickness="0" CornerRadius="20" Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,10,0">
                                <Ellipse x:Name="Pulse" Fill="{DynamicResource B.Mint}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Fill="{DynamicResource B.Mint}" Width="8" Height="8"/>
                            </Grid>
                            <TextBlock x:Name="StatusText" Style="{StaticResource T.Mono}" Text="online · watching clipboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="CardScroll" Grid.Row="1" Margin="0,21,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <UniformGrid x:Name="Cards" Columns="3"/>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="7,22,7,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource T.Body}" Foreground="{DynamicResource B.TextMute}" VerticalAlignment="Center" TextWrapping="Wrap"
                               Margin="0,0,16,0" Text="Right-click the tray icon any time. This tour lives there too."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Close" Style="{StaticResource Btn.Ghost}" Height="40" Margin="0,0,8,0" Click="OnClose" IsCancel="True"/>
                        <Button Content="Open control centre" Style="{StaticResource Btn.Accent}" Height="40" Padding="20,0" Click="OnCentre"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
