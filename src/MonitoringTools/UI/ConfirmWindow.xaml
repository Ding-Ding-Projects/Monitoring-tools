<Window x:Class="MonitoringTools.UI.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="Height" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="Root" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale"/>
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="{DynamicResource B.Raised}" BorderThickness="1" Effect="{DynamicResource Fx.Shadow}" Padding="24,22,24,20">
            <Border.BorderBrush>
                <SolidColorBrush x:Name="Edge" Color="{DynamicResource C.Line}"/>
            </Border.BorderBrush>
            <!-- the buttons stay in view; on a short screen the rest scrolls -->
            <DockPanel x:Name="Body">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="CancelBtn" Content="Keep it" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Click="OnCancel" IsCancel="True"/>
                    <Button x:Name="OkBtn" Style="{StaticResource Btn.Danger}" Click="OnOk"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <ContentControl x:Name="IconHost" HorizontalAlignment="Left" Margin="0,0,0,14"/>
                        <TextBlock x:Name="TitleText" Style="{StaticResource T.Title}" FontSize="22" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BodyText" Style="{StaticResource T.Body}" Margin="0,8,0,0" LineHeight="20"/>
                        <CheckBox x:Name="Extra" Style="{StaticResource Switch}" Margin="0,16,0,0"/>
                        <StackPanel x:Name="Gate" Visibility="Collapsed" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
