<Window x:Class="MonitoringTools.UI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize" Width="780" Height="640"
        WindowStartupLocation="CenterScreen" Title="Set up Monitoring Tools" UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="{DynamicResource B.Window}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                Effect="{StaticResource Fx.Shadow}" MouseLeftButtonDown="OnDrag">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- step rail -->
                <Border Background="{DynamicResource B.Ground}" CornerRadius="28,0,0,28" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,0,1,0" Padding="22,26,18,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                            <Path Data="M3 12h4l3-7 4 14 3-7h4" Stroke="{DynamicResource B.Mint}" StrokeThickness="2.2" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Setup" Style="{StaticResource T.Title}" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="Rail" Grid.Row="1"/>
                        <StackPanel Grid.Row="2">
                            <TextBlock x:Name="SavedNote" Style="{StaticResource T.Mono}" FontSize="11" Foreground="{DynamicResource B.TextMute}" TextWrapping="Wrap"
                                       Text="Progress saves as you go. Close any time and pick up from the tray."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- step content -->
                <Grid Grid.Column="1" Margin="34,30,30,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Height="8" CornerRadius="4" Background="{DynamicResource B.SecondaryContainer}" Margin="0,0,0,18">
                            <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource B.Mint}" Width="0"/>
                        </Border>
                        <TextBlock x:Name="StepEyebrow" Style="{StaticResource T.Eyebrow}" FontSize="12" Foreground="{DynamicResource B.Mint}"/>
                        <TextBlock x:Name="StepTitle" Style="{StaticResource T.Title}" FontSize="26" Margin="0,6,0,6"/>
                        <TextBlock x:Name="StepIntro" Style="{StaticResource T.Body}" Foreground="{DynamicResource B.TextMute}" FontSize="14" LineHeight="20"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0" Padding="0,6,14,6">
                        <ContentControl x:Name="StepBody" Focusable="False"/>
                    </ScrollViewer>
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Button x:Name="BackBtn" Content="Back" Style="{StaticResource Btn.Ghost}" Height="40" HorizontalAlignment="Left" Click="OnBack"
                                ToolTip="Back (Alt+Left)"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SkipBtn" Content="Skip this step" Style="{StaticResource Btn.Ghost}" Height="40" Margin="0,0,8,0" Click="OnSkip"/>
                            <Button x:Name="NextBtn" Content="Next" Style="{StaticResource Btn.Accent}" Height="40" Padding="22,0" Click="OnNext"
                                    ToolTip="Next (Enter)" IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Button Grid.Column="1" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0"
                        Click="OnClose" AutomationProperties.Name="Close setup and keep progress" ToolTip="Close (Esc). Progress is kept.">
                    <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
