<Window x:Class="MonitoringTools.UI.FileToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterScreen" Title="File tools" UseLayoutRounding="True">
    <Grid x:Name="Root" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="{DynamicResource B.Raised}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                Effect="{StaticResource Fx.Shadow}" Padding="22" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="IconHost" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Style="{StaticResource T.Title}" FontSize="16"/>
                        <TextBlock x:Name="SubText" Style="{StaticResource T.Mono}" Foreground="{DynamicResource B.TextMute}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" Click="OnClose" AutomationProperties.Name="Close" VerticalAlignment="Top">
                        <Path Data="M6 6l12 12M18 6L6 18" Stroke="{DynamicResource B.TextSoft}" StrokeThickness="2.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </Grid>

                <!-- segmented tabs with a sliding pill -->
                <Border Background="{DynamicResource B.Sunken}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1" CornerRadius="20" Padding="4" Margin="0,0,0,16">
                    <Grid x:Name="Tabs">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Pill" CornerRadius="16" Background="{DynamicResource B.SecondaryContainer}" HorizontalAlignment="Stretch">
                            <Border.RenderTransform><TranslateTransform x:Name="PillShift"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>

                <ContentControl x:Name="Panel" MinHeight="230"/>
                <TextBlock x:Name="Status" Style="{StaticResource T.Mono}" Margin="0,14,0,0" MinHeight="16"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
