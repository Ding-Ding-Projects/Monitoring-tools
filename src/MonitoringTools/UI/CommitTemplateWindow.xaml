<Window x:Class="MonitoringTools.UI.CommitTemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="True" ResizeMode="NoResize" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterScreen" Title="Default commit message">
    <Grid x:Name="Root" Margin="20" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="RootScale"/>
                <TranslateTransform x:Name="RootShift"/>
            </TransformGroup>
        </Grid.RenderTransform>
        <Border CornerRadius="20" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Line}" BorderThickness="1"
                Effect="{StaticResource Fx.Shadow}" Padding="24,22,24,20" MouseLeftButtonDown="OnDrag">
            <StackPanel>
                <TextBlock Text="FIRST :PUSH" Style="{StaticResource T.Eyebrow}" Foreground="{StaticResource B.Mint}"/>
                <TextBlock Text="Set a default commit message" Style="{StaticResource T.Title}" FontSize="22" Margin="0,6,0,6"/>
                <TextBlock Style="{StaticResource T.Body}" Text="Every :push uses this message. Click a snippet to drop it in; it fills in at push time."/>

                <TextBox x:Name="Input" Style="{StaticResource Input}" Margin="0,16,0,10" FontSize="13" Height="40" TextChanged="OnChanged"/>
                <WrapPanel x:Name="Snippets"/>

                <Border Background="{StaticResource B.Sunken}" CornerRadius="10" Padding="12,10" Margin="0,8,0,0" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PREVIEW" Style="{StaticResource T.Eyebrow}"/>
                        <TextBlock x:Name="Preview" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" FontSize="13" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Not now" Style="{StaticResource Btn.Ghost}" Margin="0,0,8,0" Click="OnCancel"/>
                    <Button x:Name="SaveBtn" Content="Save and push" Style="{StaticResource Btn.Accent}" Click="OnSave"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
