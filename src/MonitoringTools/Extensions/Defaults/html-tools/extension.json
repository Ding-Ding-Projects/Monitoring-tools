{
  "id": "html-tools",
  "name": "HTML tools",
  "version": "1.0.0",
  "api": 1,
  "description": "Decodes HTML entities such as &amp;amp; and &amp;#x2192;, escapes markup so it shows as text, and strips tags.",
  "author": "Monitoring Tools (built in)",
  "detect": [
    {
      "kind": "entities",
      "label": "You copied text with HTML entities",
      "pattern": "&(?:#\\d{1,7}|#x[0-9a-fA-F]{1,6}|[a-zA-Z]{2,10});"
    },
    {
      "kind": "markup",
      "label": "You copied HTML",
      "pattern": "<([a-zA-Z][a-zA-Z0-9]*)\\b[^>]*>[\\s\\S]*</\\1>|<(?:br|hr|img|input)\\b[^>]*/?>"
    }
  ],
  "actions": [
    {
      "id": "decode",
      "label": "Decode entities",
      "for": [
        "entities"
      ],
      "primary": true
    },
    {
      "id": "text",
      "label": "Keep only the text",
      "for": [
        "markup"
      ],
      "primary": true
    },
    {
      "id": "escape",
      "label": "Escape as text",
      "for": [
        "markup",
        "entities"
      ]
    }
  ],
  "run": "html-tools.ps1",
  "permissions": [
    "read-text",
    "change-clipboard"
  ]
}
