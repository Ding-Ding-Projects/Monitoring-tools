#!/bin/sh
# Runs the maintainer vocabulary lock before every push. Enable once per clone with:
#   git config core.hooksPath .githooks
# Without PowerShell on this machine the check is skipped with the reason printed.
root="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$root/scripts/check-vocabulary.ps1"
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/check-vocabulary.ps1"
fi
echo "[vocabulary] skipped: PowerShell is not available on this machine"
exit 0
